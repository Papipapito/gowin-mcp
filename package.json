{
  "name": "gowin-mcp",
  "version": "0.2.2",
  "description": "MCP server that turns Gowin EDA build reports into structured data: resource usage, fMax per clock, timing violations with a pass/fail/unknown gate, pin assignment, synthesis/PnR warnings, and build-to-build comparison.",
  "type": "module",
  "bin": {
    "gowin-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "test": "node --test tests/*.test.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "gowin",
    "fpga",
    "tang",
    "verilog",
    "timing",
    "eda"
  ],
  "author": "Papipapito",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Papipapito/gowin-mcp.git"
  },
  "homepage": "https://github.com/Papipapito/gowin-mcp#readme",
  "bugs": {
    "url": "https://github.com/Papipapito/gowin-mcp/issues"
  }
}
